# Build output and dependencies
.next/
node_modules/
pnpm-lock.yaml

# Canonical Mercurius governance artifacts are change-controlled.
# They are authored deliberately (including trailing-space line breaks)
# and must not be reformatted by tooling.
mps/
mds/
mts/
AGENTS.md

# CLAUDE.md hosts the Next.js-managed `nextjs-agent-rules` block, which must stay
# byte-identical to what `next dev` generates or it gets rewritten on every run.
CLAUDE.md

# The recorded evidence transcript is written by scripts/record-evidence.mjs and
# compared byte-for-byte against a fresh recording. The recorder is its only
# author; reformatting it here would make the verifier's diff meaningless.
lib/evidence/recorded/

# Scratch state written by the Supabase CLI. It is git-ignored via
# supabase/.gitignore, but Prettier does not read nested .gitignore files, so
# `pnpm format:check` would otherwise fail on any machine that has run the CLI.
supabase/.temp/
