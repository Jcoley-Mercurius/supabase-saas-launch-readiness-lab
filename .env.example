# Supabase SaaS Launch-Readiness Lab — environment contract (names only)
#
# This file documents APPROVED VARIABLE NAMES. It must never contain real
# values. Copy it to `.env.local` and fill values there; `.env` and `.env.*`
# are gitignored, and this example file is the only whitelisted exception.
#
# Authority: mts/INTEGRATION-MANIFEST.md, mts/SECURITY-ARCHITECTURE.md
# Rule: private values stay server-side and out of source, logs, analytics,
# URLs, screenshots, and evidence.
#
# NEXT_PUBLIC_* values are exposed to the browser by Next.js. Never give a
# secret a NEXT_PUBLIC_ prefix.

# --- Application (S1) ---------------------------------------------------
# Public canonical origin for the deployed environment.
NEXT_PUBLIC_SITE_URL=

# --- Supabase (S2, S5) --------------------------------------------------
# Publishable key may be client-visible; it is protected by grants and RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses RLS, so it is NOT approved for general use and must
# never reach the browser. INTEGRATION-MANIFEST.md admits it "only if a later
# approved server operation requires it." Leave unset until that approval.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Inquiry notification via Resend (S5) -------------------------------
# Server-only. Preview and production must use SEPARATE values, and preview
# must use a preview-safe notification destination: set these in the Vercel
# Preview scope separately from Production, and point INQUIRY_NOTIFICATION_TO
# at an address that is safe to fill with test submissions.
#
# The application labels every non-production notification in its subject and
# first line (lib/inquiry/notify.ts, labelForEnvironment), so a preview message
# can never be mistaken for a live inquiry even if these values are wrong. The
# label is a safety net, not a substitute for setting them per environment.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
INQUIRY_NOTIFICATION_TO=

# --- Measurement (S6) ---------------------------------------------------
# MTS-DEC-016 settled this: first-party only, counted into the project's own
# Supabase Postgres, with no third-party analytics provider. PostHog was NOT
# adopted, so there is no analytics key to configure here and adding one would
# be an MTS decision rather than an implementation choice.
#
# Measurement therefore needs no variable of its own. It reuses
# NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY above, and
# writes to the isolated `measurement` schema, which holds no inquiry content,
# no free text, and no identifier. The deployment is read from VERCEL_ENV,
# which Vercel sets; unset means local, so an unknown environment is never
# recorded as production.

# --- Inquiry operator tooling (S5, test-only, not runtime) --------------
# Consumed by scripts/verify-inquiry.mjs and scripts/retain-inquiries.mjs
# (`pnpm inquiries:check`, `pnpm inquiries:retain`). A direct PostgreSQL
# connection string for the ISOLATED inquiry database - never the synthetic
# fixture database, which the scripts refuse to run against. The application
# never reads it. Unset, the scripts use a local `inquiry_local` database
# inside the development container.
# INQUIRY_DATABASE_URL=

# --- Browser verification (test-only, not runtime) ----------------------
# Consumed by playwright.config.ts. Defaults to http://localhost:3000.
# PLAYWRIGHT_BASE_URL=
# Set to 1 to enable the webkit-desktop project. CI only; the required system
# packages are not installed on the workstation.
# PLAYWRIGHT_WEBKIT=
